 @property (readonly) uint64_t totalWantedDone;
 @property (readonly) uint64_t totalDownload;
 @property (readonly) uint64_t totalUpload;
+/// File data sent to peers, excluding protocol overhead.
+@property (readonly) uint64_t totalPayloadUpload;
 @property (readonly) BOOL isPaused;
 @property (readonly) BOOL isFinished;
 @property (readonly) BOOL isSeed;
diff --git a/LibTorrent/Core/TorrentHandleSnapshot/TorrentHandleSnapshot.mm b/LibTorrent/Core/TorrentHandleSnapshot/TorrentHandleSnapshot.mm
index 39c97ba..deafcd6 100644
--- a/LibTorrent/Core/TorrentHandleSnapshot/TorrentHandleSnapshot.mm
+++ b/LibTorrent/Core/TorrentHandleSnapshot/TorrentHandleSnapshot.mm
@@ -225,6 +225,10 @@ - (uint64_t)totalUpload {
     return _status.total_upload;
 }
 
+- (uint64_t)totalPayloadUpload {
+    return _status.total_payload_upload;
+}
+
 - (BOOL)isPaused {
     return static_cast<bool>(_status.flags & lt::torrent_flags::paused);
 }
